# Copy to .env and adjust as needed. All values below are safe local defaults.

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=searchsphere
POSTGRES_USER=searchsphere
POSTGRES_PASSWORD=searchsphere
DATABASE_URL=postgresql+psycopg://searchsphere:searchsphere@localhost:5432/searchsphere

# --- Redis ---
# Dedicated DB index (not 0) to avoid colliding with other local projects
# sharing the same Redis instance.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=3
REDIS_URL=redis://localhost:6379/3
CACHE_TTL_SECONDS=60

# --- BM25 ranking parameters ---
BM25_K1=1.5
BM25_B=0.75

# --- API ---
API_TITLE=SearchSphere
API_DEFAULT_PAGE_SIZE=10
API_MAX_PAGE_SIZE=100
AUTOCOMPLETE_MAX_SUGGESTIONS=10
